# ── VEXA Backend — Railway Environment Variables ──────────────────────────────
# Copy to .env for local development

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase: Settings → Database → Connection string → URI (use Transaction Pooler)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ── Redis (Railway adds this automatically when you add the Redis plugin) ─────
REDIS_URL=redis://default:password@redis.railway.internal:6379

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret  # Settings → API → JWT Secret

# ── CORS — comma-separated, no trailing slash ─────────────────────────────────
CORS_ORIGINS=https://your-project.vercel.app

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...

# ── WhatsApp (optional) ───────────────────────────────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=vexa
WHATSAPP_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
